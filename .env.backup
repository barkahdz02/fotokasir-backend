NODE_ENV=development
PORT=3000
APP_NAME=FotoKasir API

DATABASE_PATH=./data/fotokasir.db

JWT_SECRET=fotokasir-super-secret-key-min-32-characters-long
JWT_EXPIRES_IN=1h
